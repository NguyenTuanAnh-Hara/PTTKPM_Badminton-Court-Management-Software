# Sao chép tệp này thành .env rồi sửa cho đúng máy của bạn

# Kết nối MySQL: mysql://TÊN_ĐĂNG_NHẬP:MẬT_KHẨU@localhost:3306/TÊN_CSDL
DATABASE_URL="mysql://root:matkhau@localhost:3306/san_cau_long"

PORT=3000
FRONTEND_URL="http://localhost:5173"

# Chuỗi bí mật ký cookie phiên đăng nhập – đổi thành chuỗi ngẫu nhiên dài
# Khi NODE_ENV=production: bắt buộc ≥ 32 ký tự (tạo bằng: openssl rand -hex 32) và VNPAY_MODE phải là sandbox
SESSION_SECRET="doi-chuoi-nay-thanh-chuoi-ngau-nhien"

# Gmail SMTP (mật khẩu ứng dụng). Để trống thì nội dung email được in ra màn hình console.
EMAIL_USER=""
EMAIL_APP_PASSWORD=""

# VNPAY: mock = giả lập (không cần tài khoản); sandbox = cổng thử nghiệm thật của VNPAY
VNPAY_MODE="mock"
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET="chuoi-bi-mat-gia-lap"
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"

# Tham số nghiệp vụ (*) của mục 3.2.5 – bỏ trống để dùng giá trị mặc định
# GIU_CHO_PHUT=10
# GIU_CHO_LE_TAN_PHUT=30
# PHAN_TRAM_HOAN_SAN=50
